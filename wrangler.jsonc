{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ichimoku",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "501dbc4d443b4cb283b39c3214ce083f" }
  ],
  // Etter stengning: Oslo (16:20 lokal) og New York (16:00 ET), hverdager, UTC.
  "triggers": { "crons": ["30 15 * * 1-5", "30 21 * * 1-5"] },
  "vars": {
    "APP_URL": ""
  }
  // Secrets settes i Cloudflare-dashbordet: APP_USER, APP_PASSWORD og NTFY_TOPIC.
}
